#!/usr/bin/env python3
"""Extend CachyOS Calamares configuration without changing existing choices.

The stock installer is installed in the live session, so its own files are
modified there. Both the target post-installation files and the final shell
process are registered while preserving the original YAML sequence indent.
"""
import os
from pathlib import Path
import sys

FILES = [
    "/usr/local/bin/skaldr-postinstall",
    "/usr/local/bin/skaldr-profile",
    "/usr/local/bin/skaldr-welcome",
    "/usr/local/bin/skaldr-theme",
    "/usr/share/pixmaps/skaldr-logo.png",
    "/usr/share/icons/hicolor/128x128/apps/skaldr.png",
    "/usr/share/wallpapers/Skaldr/metadata.json",
    "/usr/share/wallpapers/Skaldr/contents/images/3840x2160.svg",
    "/usr/share/wallpapers/Skaldr/contents/images/5120x2160.svg",
    "/etc/xdg/autostart/skaldr-theme.desktop",
    "/usr/local/bin/skaldr-version",
    "/usr/share/skaldr/build.json",
    "/etc/skaldr-release",
    "/etc/xdg/autostart/skaldr-welcome.desktop",
    "/usr/local/bin/skaldr-doctor",
    "/usr/local/bin/skaldr-report",
    "/usr/local/bin/skaldr-gpu-diagnostics",
    "/usr/local/bin/skaldr-recovery",
    "/usr/local/bin/skaldr-update",
    "/usr/local/bin/skaldr-performance",
    "/usr/local/bin/skaldr-center",
    "/usr/share/skaldr/os-release",
    "/usr/share/applications/skaldr-center.desktop",
    "/usr/local/bin/skaldr-numlock",
    "/etc/systemd/system/skaldr-numlock.service",
    "/etc/xdg/kcminputrc",
    # Do not copy /etc/skel/.config/kcminputrc into the target before pacman.
    # cachyos-kde-settings owns that path and must install it first.
    "/etc/skel/.config/kscreenlockerrc",
    "/etc/skel/.config/kwalletrc",
    "/usr/local/bin/skaldr-gpu-assistant",
    "/usr/local/bin/skaldr-artcraft",
    "/opt/skaldr/artcraft/artcraft-launcher.AppImage",
    "/usr/share/licenses/skaldr-artcraft/LICENSE-APACHE",
    "/usr/share/licenses/skaldr-artcraft/LICENSE-MIT",
    "/usr/share/licenses/skaldr-artcraft/NOTICE",
    "/usr/share/skaldr/packages.txt",
    "/usr/share/applications/skaldr-artcraft.desktop",
    "/etc/xdg/autostart/skaldr-gpu-assistant.desktop",
    "/etc/systemd/system/skaldr-performance.service",
    "/etc/systemd/system/scx_loader.service.d/10-skaldr-kernel.conf",
]


def insert_in_sequence(document, key, item_lines, identity, default_indent):
    lines = document.splitlines(keepends=True)
    # Only accept a top-level block sequence; never inject into a nested key.
    section = next((i for i, line in enumerate(lines)
                    if line and not line[0].isspace() and line.strip() == key + ":"), None)
    if section is None:
        raise ValueError("Missing Calamares key: " + key)
    end = next((i for i in range(section + 1, len(lines))
                if lines[i].strip() and not lines[i][0].isspace()), len(lines))
    existing = lines[section + 1:end]
    # A comment mentioning a hook is not evidence that the hook is installed.
    if any(identity in line for line in existing if not line.lstrip().startswith("#")):
        return document
    indent = default_indent
    for line in lines[section + 1:end]:
        if line.lstrip().startswith("- "):
            indent = line[:len(line) - len(line.lstrip())]
            break
    new_lines = [indent + item_lines[0] + "\n"]
    new_lines += [indent + "  " + line + "\n" for line in item_lines[1:]]
    lines[end:end] = new_lines
    return "".join(lines)


def main():
    root = Path(os.environ.get("SKALDR_CALAMARES_MODULES", "/etc/calamares/modules"))
    pacstrap = root / "pacstrap.conf"
    shellprocess = root / "shellprocess.conf"
    if not pacstrap.is_file() or not shellprocess.is_file():
        sys.exit("Required Calamares configuration missing; refusing unconfigured installation")

    # Validate both module configurations before modifying either one.
    # Otherwise a missing shellprocess script section could leave the
    # pacstrap configuration partly modified after an installer error.
    original_pacstrap = pacstrap.read_text()
    original_shellprocess = shellprocess.read_text()
    updated_pacstrap = original_pacstrap
    for path in FILES:
        updated_pacstrap = insert_in_sequence(updated_pacstrap, "postInstallFiles",
                                              ['- "' + path + '"'], '"' + path + '"', "  ")
    updated_shellprocess = insert_in_sequence(
        original_shellprocess, "script",
        ['- command: "/usr/local/bin/skaldr-postinstall"',
         "timeout: 3600", "verbose: true"],
        "/usr/local/bin/skaldr-postinstall", "    ")

    if original_pacstrap != updated_pacstrap:
        pacstrap.write_text(updated_pacstrap)
    if original_shellprocess != updated_shellprocess:
        shellprocess.write_text(updated_shellprocess)

    print("Skaldr OS target installation integration enabled")


if __name__ == "__main__":
    main()
