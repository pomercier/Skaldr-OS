#!/usr/bin/env python3
"""Finish installing the same Skaldr applications inside Calamares target."""
from pathlib import Path
import subprocess
import sys

def call(*args):
    subprocess.run(args, check=True)

def main():
    pkg = Path("/usr/share/skaldr/packages.txt")
    if not pkg.exists():
        sys.exit("Skaldr package manifest missing in target")
    packages = [v.strip() for v in pkg.read_text().splitlines() if v.strip() and not v.startswith("#")]
    call("pacman", "-S", "--needed", "--noconfirm", *packages)
    if subprocess.run(["pacman", "-Qq", "firefox"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        call("pacman", "-Rns", "--noconfirm", "firefox")
    call("/usr/local/bin/skaldr-profile", "install")
    print("Skaldr target packages and system preferences installed")

if __name__ == "__main__":
    main()
