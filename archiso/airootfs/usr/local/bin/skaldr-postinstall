#!/usr/bin/env python3
"""Finish installing the same Skaldr applications inside Calamares target."""
from pathlib import Path
import os
import pwd
import shutil
import subprocess
import sys
import re
import shlex

def call(*args):
    subprocess.run(args, check=True)

def setup_user_autostart(home, uid, gid, source):
    """Start the Skaldr greeting in new KDE accounts; keep CachyOS Hello installed."""
    if not home.is_dir() or home.is_symlink():
        raise RuntimeError(f"Invalid installed user home: {home}")
    folder = home / ".config" / "autostart"
    if folder.is_symlink():
        raise RuntimeError(f"Refusing symlink autostart directory: {folder}")
    folder.mkdir(parents=True, exist_ok=True)
    os.chown(folder, uid, gid)

    # cachyos-hello installs an autostart into /etc/skel, copied by Calamares
    # to users' homes. Suppress the redundant launch, not the application.
    upstream = folder / "cachyos-hello.desktop"
    if upstream.is_file():
        if upstream.is_symlink():
            raise RuntimeError(f"Refusing symlink autostart entry: {upstream}")
        upstream.write_text("[Desktop Entry]\nType=Application\nName=CachyOS Hello\nHidden=true\n")
        os.chown(upstream, uid, gid)

    target = folder / "skaldr-welcome.desktop"
    if target.is_symlink():
        raise RuntimeError(f"Refusing symlink Skaldr entry: {target}")
    target.write_text(source.read_text())
    os.chown(target, uid, gid)
    print(f"Skaldr: installed first-login autostart for UID {uid}", flush=True)


def configure_installed_users():
    source = Path("/etc/xdg/autostart/skaldr-welcome.desktop")
    if not source.is_file():
        raise RuntimeError("Skaldr welcome autostart entry missing")
    for account in pwd.getpwall():
        home = Path(account.pw_dir)
        if not (1000 <= account.pw_uid < 60000 and home.parent == Path("/home")):
            continue
        if home.is_dir():
            setup_user_autostart(home, account.pw_uid, account.pw_gid, source)


def configure_installed_login_wallpaper(
    config=Path("/etc/plasmalogin.conf"),
    wallpaper=Path("/usr/share/wallpapers/Skaldr/contents/images/3840x2160.svg"),
):
    """Apply Skaldr login art through KDE's own KConfig editor.

    The live ISO autologin file is NEVER copied into the installed system.
    Only the wallpaper plugin and Image keys change. The login user's
    password, session and autologin settings remain owned by the installer.
    End users can subsequently change the wallpaper in System Settings.
    """
    if not wallpaper.is_file() or wallpaper.is_symlink():
        print("Skaldr: login wallpaper missing; original greeter kept.", flush=True)
        return False
    if config.is_symlink():
        raise RuntimeError("Refusing to modify symlinked login manager configuration")
    if not shutil.which("kwriteconfig6"):
        print("Skaldr: kwriteconfig6 unavailable; original greeter kept.", flush=True)
        return False
    call("kwriteconfig6", "--file", str(config), "--group", "Greeter",
         "--key", "WallpaperPluginId", "org.kde.image")
    call("kwriteconfig6", "--file", str(config), "--group", "Greeter",
         "--group", "Wallpaper", "--group", "org.kde.image",
         "--group", "General", "--key", "Image", wallpaper.as_uri())
    print("Skaldr login wallpaper configured.", flush=True)
    return True



def verify_limine_uefi_esp(root=Path("/"), *, limine_installed=None,
                           uefi=None, filesystem=None):
    """Fail installation if the selected Limine EFI setup cannot load a menu.

    Read-only: never format disks, copy unverified bootloaders or modify NVRAM.
    This checks the mounted ESP, not firmware boot order or other disks.
    """
    root = Path(root)
    if limine_installed is None:
        limine_installed = subprocess.run(
            ["pacman", "-Qq", "limine"], stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, check=False).returncode == 0
    if not limine_installed:
        return False  # GRUB, systemd-boot, rEFInd: do not interfere.
    if uefi is None:
        uefi = (root / "sys/firmware/efi").is_dir()
    if not uefi:
        return False  # BIOS installations need a separate boot-chain audit.

    prefs = root / "etc/default/limine"
    if not prefs.is_file() or prefs.is_symlink():
        raise RuntimeError("Limine UEFI preflight: /etc/default/limine missing or unsafe")
    lines = [line.split("=", 1)[1].strip()
             for line in prefs.read_text(encoding="utf-8").splitlines()
             if re.match(r"^\s*ESP_PATH\s*=", line)]
    if len(lines) != 1:
        raise RuntimeError("Limine UEFI preflight: expected exactly one ESP_PATH")
    try:
        values = shlex.split(lines[0], comments=True)
    except ValueError as exc:
        raise RuntimeError("Limine UEFI preflight: malformed ESP_PATH") from exc
    if len(values) != 1:
        raise RuntimeError("Limine UEFI preflight: ambiguous ESP_PATH")
    esp_name = values[0]
    esp_path = Path(esp_name)
    if (not esp_path.is_absolute() or esp_path == Path("/") or
            ".." in esp_path.parts or "$" in esp_name):
        raise RuntimeError("Limine UEFI preflight: unsafe ESP_PATH")
    esp = root / esp_path.relative_to("/")
    if esp.is_symlink() or not esp.is_dir() or not esp.resolve().is_relative_to(root.resolve()):
        raise RuntimeError("Limine UEFI preflight: ESP path is missing or unsafe")
    if filesystem is None:
        checked = subprocess.run(
            ["findmnt", "-rnM", str(esp), "-o", "FSTYPE"],
            capture_output=True, text=True, check=False, timeout=10)
        filesystem = checked.stdout.strip() if checked.returncode == 0 else None
    if filesystem != "vfat":
        raise RuntimeError("Limine UEFI preflight: ESP_PATH is not an exact mounted FAT ESP")
    config = esp / "limine.conf"
    if not config.is_file() or config.is_symlink():
        raise RuntimeError("Limine UEFI preflight: limine.conf missing on mounted ESP")
    data = config.read_text(encoding="utf-8", errors="replace")
    if not re.search(r"(?m)^\s*protocol:\s*linux\b", data):
        raise RuntimeError("Limine UEFI preflight: no Linux boot entry in limine.conf")
    if not any((esp / path).is_file() for path in (
            "EFI/limine/limine_x64.efi", "EFI/BOOT/BOOTX64.EFI")):
        raise RuntimeError("Limine UEFI preflight: EFI executable missing on mounted ESP")
    print(f"Skaldr: Limine UEFI preflight OK (mounted FAT ESP {esp_path}, "
          "config, Linux menu and EFI binary present)", flush=True)
    return True


def _refind_esp_filesystem(esp):
    """Identify FAT even when Calamares chroot lacks a usable mount table.

    findmnt --target is preferred, but mountinfo can be incomplete inside
    the isolated installation environment. GNU statfs queries the *actual*
    filesystem backing /boot without requiring /proc or mountinfo.
    """
    mounted = subprocess.run(
        ["findmnt", "-rnT", str(esp), "-o", "FSTYPE"],
        capture_output=True, text=True, timeout=10, check=False
    )
    if mounted.returncode == 0 and mounted.stdout.strip() == "vfat":
        return "vfat"
    checked = subprocess.run(
        ["stat", "-f", "-c", "%T", str(esp)],
        capture_output=True, text=True, timeout=10, check=False
    )
    if checked.returncode == 0 and checked.stdout.strip() in ("msdos", "vfat"):
        return "vfat"
    return None


def ensure_refind_uefi_fallback(root=Path("/"), *, refind_installed=None,
                               uefi=None, filesystem=None):
    """Provide a verified rEFInd removable fallback when OVMF loses NVRAM.

    Write only to the exact mounted FAT ESP and only when rEFInd is selected.
    Never overwrite a differing EFI loader or use an untrusted binary.
    """
    import hashlib

    root = Path(root)
    if refind_installed is None:
        refind_installed = subprocess.run(
            ["pacman", "-Qq", "refind"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            check=False
        ).returncode == 0
    if not refind_installed:
        return False
    if uefi is None:
        uefi = (root / "sys/firmware/efi").is_dir()
    if not uefi:
        return False

    esp = root / "boot"
    if esp.is_symlink() or not esp.is_dir() or not esp.resolve().is_relative_to(root.resolve()):
        raise RuntimeError("rEFInd fallback: /boot ESP is missing or unsafe")
    if filesystem is None:
        # A mounted ESP must have a distinct device from the installed
        # root. In a Calamares chroot, findmnt can fail because /proc
        # mountinfo does not reflect chroot-relative mountpoints. statfs
        # identifies the actual FAT filesystem without using that table.
        if os.stat(esp).st_dev == os.stat(root).st_dev:
            raise RuntimeError("rEFInd fallback: /boot is not an exact mounted FAT ESP (same device as root)")
        filesystem = _refind_esp_filesystem(esp)
    if filesystem != "vfat":
        raise RuntimeError("rEFInd fallback: /boot is not an exact mounted FAT ESP")

    source = esp / "EFI/refind/refind_x64.efi"
    target_dir = esp / "EFI/BOOT"
    target = target_dir / "BOOTX64.EFI"
    if source.is_symlink() or not source.is_file():
        raise RuntimeError("rEFInd fallback: expected EFI binary missing")
    with source.open("rb") as stream:
        if stream.read(2) != b"MZ":
            raise RuntimeError("rEFInd fallback: source is not a PE/EFI binary")
    if source.stat().st_size < 4096:
        raise RuntimeError("rEFInd fallback: source EFI binary unexpectedly small")

    def checksum(file):
        with file.open("rb") as stream:
            return hashlib.file_digest(stream, "sha256").digest()

    if target_dir.is_symlink():
        raise RuntimeError("rEFInd fallback: refusing symlinked EFI/BOOT directory")
    target_dir.mkdir(parents=True, exist_ok=True)
    if target.is_symlink():
        raise RuntimeError("rEFInd fallback: refusing symlinked EFI loader")
    if target.exists():
        if not target.is_file() or checksum(target) != checksum(source):
            raise RuntimeError("rEFInd fallback: different bootloader already owns EFI/BOOT")
        print("Skaldr: matching rEFInd UEFI fallback verified", flush=True)
        return True

    with source.open("rb") as incoming, target.open("xb") as outgoing:
        shutil.copyfileobj(incoming, outgoing)
    if checksum(target) != checksum(source):
        raise RuntimeError("rEFInd fallback: EFI copy checksum mismatch")
    print("Skaldr: rEFInd UEFI fallback installed on mounted FAT ESP", flush=True)
    return True

def main():
    pkg = Path("/usr/share/skaldr/packages.txt")
    if not pkg.exists():
        sys.exit("Skaldr package manifest missing in target")
    packages = [v.strip() for v in pkg.read_text().splitlines() if v.strip() and not v.startswith("#")]
    call("pacman", "-Syu", "--needed", "--noconfirm", *packages)
    if subprocess.run(["pacman", "-Qq", "firefox"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        call("pacman", "-Rns", "--noconfirm", "firefox")
    # The official cachyos-kde-settings package owns /etc/skel/.config/kcminputrc.
    # Apply Skaldr's NumLock preference only after Calamares has installed it.
    call("/usr/local/bin/skaldr-numlock")
    call("/usr/local/bin/skaldr-profile", "install")
    configure_installed_users()
    configure_installed_login_wallpaper()
    verify_limine_uefi_esp()
    ensure_refind_uefi_fallback()
    print("Skaldr target packages and system preferences installed")

if __name__ == "__main__":
    main()
