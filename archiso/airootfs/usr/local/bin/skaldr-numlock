#!/usr/bin/env bash
# Configure NumLock for Plasma and its supported graphical login managers.
set -euo pipefail
source_file="/etc/xdg/kcminputrc"
[[ -f "$source_file" ]] || exit 1

# Populate /etc/skel only after pacman installs cachyos-kde-settings.
# Never overlay a path belonging to an official package during mkarchiso.
install -d -m 0755 /etc/skel/.config
install -m 0644 "$source_file" /etc/skel/.config/kcminputrc
for user in plasmalogin sddm; do
    if getent passwd "$user" >/dev/null; then
        home="$(getent passwd "$user" | cut -d: -f6)"
        group="$(id -gn "$user")"
        if [[ "$user" == "plasmalogin" ]]; then
            target="$home/.config/kdedefaults/kcminputrc"
        else
            target="$home/.config/kcminputrc"
        fi
        # The greeter must own its .config directory. Creating it as root
        # makes plasma-login-wallpaper fail before the login screen appears.
        install -d -m 0755 -o "$user" -g "$group" "$home/.config"
        install -d -m 0755 -o "$user" -g "$group" "$(dirname "$target")"
        install -m 0644 -o "$user" -g "$group" "$source_file" "$target"
        if [[ "$user" == "plasmalogin" && -f "$home/.config/plasma-login-wallpaperrc" ]]; then
            chown "$user:$group" "$home/.config/plasma-login-wallpaperrc"
        fi
    fi
done
