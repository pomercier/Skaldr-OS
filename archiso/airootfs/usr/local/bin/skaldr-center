#!/usr/bin/env bash
# Native Qt6 is preferred; preserve the proven kdialog hub as a safe fallback.
set -euo pipefail
if [[ "${SKALDR_CENTER_LEGACY:-0}" == "1" ]]; then
    exec /usr/local/bin/skaldr-center-legacy "$@"
fi
if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]] &&
   /usr/bin/python3 -c 'from PySide6 import QtWidgets' >/dev/null 2>&1; then
    exec /usr/bin/python3 /usr/local/bin/skaldr-control-center "$@"
fi
exec /usr/local/bin/skaldr-center-legacy "$@"
