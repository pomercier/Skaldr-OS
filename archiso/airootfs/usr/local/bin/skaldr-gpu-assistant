#!/usr/bin/env bash
# Hardware-neutral first-boot driver assistant. Never change drivers without consent.
set -euo pipefail

if [[ -d /run/archiso || -f "$HOME/.config/skaldr/gpu-choice-complete" ]]; then exit 0; fi
for app in chwd lspci kdialog pkexec; do
    command -v "$app" >/dev/null 2>&1 || exit 0
done

gpu_info="$(lspci -nn | grep -Ei 'VGA compatible controller|3D controller|Display controller' || true)"
[[ -n "$gpu_info" ]] || exit 0

# chwd --list enumerates profiles for detected devices; --list-all is unfiltered.
available="$(chwd --list 2>/dev/null || true)"
message="Detected graphics hardware:
$gpu_info

CachyOS will detect compatible drivers for your hardware.
NVIDIA can use proprietary components; AMD and Intel normally use
open-source Mesa drivers. No brand-specific driver is imposed."

if printf '%s\n' "$gpu_info" | grep -Eiq 'NVIDIA|\[10de:' &&
   printf '%s\n' "$available" | grep -Fq nouveau; then
    selection="$(kdialog --title "Skaldr OS graphics drivers" --menu "$message" \
        recommended "Install compatible CachyOS drivers (default)" \
        nouveau "Install the supported open-source Nouveau profile" \
        keep "Keep existing drivers" || true)"
else
    selection="$(kdialog --title "Skaldr OS graphics drivers" --menu "$message" \
        recommended "Install compatible CachyOS drivers (default)" \
        keep "Keep existing drivers" || true)"
fi

case "$selection" in
    recommended)
        kdialog --yesno "Allow CachyOS to install compatible hardware drivers? A reboot may be required." || exit 0
        pkexec chwd -a || exit 1
        ;;
    nouveau)
        printf '%s\n' "$available" | grep -Fq nouveau || exit 1
        kdialog --yesno "Install the available Nouveau profile?" || exit 0
        pkexec chwd -i nouveau || exit 1
        ;;
    keep)
        ;;
    *)
        exit 0
        ;;
esac

mkdir -p "$HOME/.config/skaldr"
touch "$HOME/.config/skaldr/gpu-choice-complete"
