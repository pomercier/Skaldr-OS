#!/usr/bin/env bash
# Open the verified official AppImage bundled by the Skaldr ISO builder.
set -euo pipefail
app="/opt/skaldr/artcraft/artcraft-launcher.AppImage"
if [[ ! -x "$app" ]]; then
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Skaldr OS — ArtCraft" --error \
            "ArtCraft Launcher is missing from this ISO. Reinstall or verify the image."
    fi
    echo "Missing ArtCraft Launcher: $app" >&2
    exit 1
fi
exec "$app" "$@"
