#!/usr/bin/env bash
# Launch an installed ArtCraft app, otherwise show the official source.
set -euo pipefail
if command -v artcraft-launcher >/dev/null; then exec artcraft-launcher; fi
if [[ -x "$HOME/Applications/ArtCraft/ArtCraft-Launcher.AppImage" ]]; then
    exec "$HOME/Applications/ArtCraft/ArtCraft-Launcher.AppImage"
fi
printf '%s\n' "ArtCraft Launcher is not installed." \
    "Official source: https://github.com/storytold/craft-launcher/releases"
if command -v kdialog >/dev/null; then
    if kdialog --yesno 'Open the official ArtCraft Launcher releases page to install a native AppImage?'; then
        xdg-open 'https://github.com/storytold/craft-launcher/releases'
    fi
fi
