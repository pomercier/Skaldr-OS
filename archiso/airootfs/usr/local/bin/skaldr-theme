#!/usr/bin/env bash
# Apply the wallpaper once per KDE user; never override later customizations.
set -euo pipefail
wallpaper="/usr/share/wallpapers/Skaldr/contents/images/1920x1080.svg"
marker="$HOME/.config/skaldr/wallpaper-applied"
[[ -s "$wallpaper" ]] || exit 0
if [[ -f "$marker" && "${1:-}" != "--force" ]]; then exit 0; fi
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    if plasma-apply-wallpaperimage --fill-mode preserveAspectCrop "$wallpaper"; then
        mkdir -p "$(dirname "$marker")"
        touch "$marker"
    fi
fi
