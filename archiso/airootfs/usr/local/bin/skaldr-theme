#!/usr/bin/env bash
# Apply the wallpaper once per KDE user; never override later customizations.
set -euo pipefail
wallpaper="/usr/share/wallpapers/Skaldr/contents/images/3840x2160.svg"
if command -v kscreen-doctor >/dev/null 2>&1 && kscreen-doctor -o 2>/dev/null | grep -Eq "5120x2160|3440x1440"; then
    wallpaper="/usr/share/wallpapers/Skaldr/contents/images/5120x2160.svg"
fi
marker="$HOME/.config/skaldr/wallpaper-applied"
[[ -s "$wallpaper" ]] || exit 0
if [[ -f "$marker" && "${1:-}" != "--force" ]]; then exit 0; fi
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    if plasma-apply-wallpaperimage --fill-mode preserveAspectCrop "$wallpaper"; then
        mkdir -p "$(dirname "$marker")"
        touch "$marker"
    fi
fi
