#!/usr/bin/env python3
"""Read-only Skaldr recovery readiness; never performs rollback or boot edits."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess


def command(*args):
    if not shutil.which(args[0]):
        return None
    try:
        p = subprocess.run(args, capture_output=True, text=True,
                           check=False, timeout=12)
        return p.stdout.strip() if p.returncode == 0 else None
    except (subprocess.TimeoutExpired, OSError):
        return None


def status(root=Path("/")):
    # No snapshot or bootloader modification is made.
    filesystem = command("findmnt", "-n", "-o", "FSTYPE", "/") or "unknown"
    snapper_conf = command("snapper", "--no-dbus", "-c", "root", "get-config")
    snapper_present = shutil.which("snapper") is not None
    kernels = sorted({p.name for p in (root / "boot").glob("vmlinuz-*")})
    config_files = {
        "grub": (root / "boot/grub/grub.cfg").is_file(),
        "limine": (root / "boot/limine.conf").is_file(),
        "systemd_boot": (root / "boot/loader/loader.conf").is_file(),
    }
    return {
        "schema": "skaldr.recovery-readiness.v1",
        "root_filesystem": filesystem,
        "snapper_installed": snapper_present,
        "snapper_root_configured": snapper_conf is not None,
        "available_kernel_filenames": kernels[:30],
        "bootloader_config_present": config_files,
        "rollback_verified": False,
        "note": ("No rollback or boot entries were changed. File presence "
                 "alone never proves the system will recover after failure."),
    }


def main(argv=None):
    argparse.ArgumentParser(description=__doc__).parse_args(argv)
    print(json.dumps(status(), indent=2))


if __name__ == "__main__":
    main()
