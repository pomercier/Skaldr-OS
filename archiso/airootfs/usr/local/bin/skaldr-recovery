#!/usr/bin/env python3
"""Read-only Skaldr recovery readiness; never performs rollback or boot edits."""
import argparse
import json
import re
import shlex
from pathlib import Path
import shutil
import subprocess


def command(*args):
    if not shutil.which(args[0]):
        return None
    try:
        p = subprocess.run(args, capture_output=True, text=True,
                           check=False, timeout=12)
        return p.stdout.strip() if p.returncode == 0 else None
    except (subprocess.TimeoutExpired, OSError):
        return None


def root_subvolume_override(cmdline):
    """Extract the active kernel's explicit Btrfs root subvolume, if supplied.

    A mount with subvol= or subvolid= overrides the Btrfs default subvolume.
    This read-only probe does not attempt to interpret future boot entries.
    """
    if cmdline is None:
        return None
    try:
        arguments = shlex.split(cmdline)
    except ValueError:
        arguments = cmdline.split()
    override = None
    for argument in arguments:
        if not argument.startswith("rootflags="):
            continue
        for option in argument.partition("=")[2].split(","):
            name, separator, value = option.strip().partition("=")
            if separator and name in ("subvol", "subvolid") and value:
                override = f"{name}={value}"
    return override


def kernel_command_line(root):
    try:
        return (root / "proc/cmdline").read_text(encoding="utf-8").strip()
    except OSError:
        return None



def _noncomment_lines(path, limit=12000):
    """Read a bounded portion of a known boot file; never execute its content."""
    try:
        with path.open("r", encoding="utf-8", errors="replace") as source:
            for index, line in enumerate(source):
                if index >= limit:
                    break
                if line.strip() and not line.lstrip().startswith("#"):
                    yield line
    except OSError:
        return


def _entry_rootflags(line):
    # The raw kernel command line can contain other confidential options.
    # Only the bounded subvolume selector is retained in our JSON report.
    for match in re.finditer(
        r"(?:^|[\s'\"=])rootflags=['\"]?([^\s'\"\\]+)", line
    ):
        value = root_subvolume_override("rootflags=" + match.group(1))
        if value is not None:
            yield value[:256]


def configured_boot_root_overrides(root):
    """Read hints from common boot entries; never claim exhaustive coverage."""
    sources = {
        "grub": [root / "boot/grub/grub.cfg"],
        "limine": [root / "boot/limine.conf",
                   root / "boot/limine/limine.conf",
                   root / "efi/limine.conf"],
        "systemd_boot": sorted((root / "boot/loader/entries").glob("*.conf"))[:64]
                        + sorted((root / "efi/loader/entries").glob("*.conf"))[:64],
    }
    output = {}
    checked = {}
    for loader, candidates in sources.items():
        existing = [p for p in candidates if p.is_file()]
        checked[loader] = bool(existing)
        selectors = set()
        for path in existing:
            for line in _noncomment_lines(path):
                selectors.update(_entry_rootflags(line))
        output[loader] = sorted(selectors)
    return output, checked


def fstab_root_subvolume_override(root):
    """Detect explicit subvol selection for / in a Btrfs /etc/fstab."""
    for line in _noncomment_lines(root / "etc/fstab"):
        columns = line.split()
        if len(columns) < 4 or columns[1] != "/" or columns[2] != "btrfs":
            continue
        for option in columns[3].split(","):
            key, delimiter, value = option.partition("=")
            if delimiter and key in ("subvol", "subvolid") and value:
                return f"{key}={value[:256]}"
    return None


def status(root=Path("/")):
    # No snapshot or bootloader modification is made.
    filesystem = command("findmnt", "-n", "-o", "FSTYPE", "/") or "unknown"
    snapper_conf = command("snapper", "--no-dbus", "-c", "root", "get-config")
    snapper_present = shutil.which("snapper") is not None
    cmdline = kernel_command_line(root)
    override = root_subvolume_override(cmdline)
    configured, checked = configured_boot_root_overrides(root)
    fstab_override = fstab_root_subvolume_override(root)
    any_override = bool(override or fstab_override or any(configured.values()))
    kernels = sorted({p.name for p in (root / "boot").glob("vmlinuz-*")})
    config_files = {
        "grub": (root / "boot/grub/grub.cfg").is_file(),
        "limine": (root / "boot/limine.conf").is_file(),
        "systemd_boot": (root / "boot/loader/loader.conf").is_file(),
    }
    return {
        "schema": "skaldr.recovery-readiness.v1",
        "root_filesystem": filesystem,
        "snapper_installed": snapper_present,
        "snapper_root_configured": snapper_conf is not None,
        "available_kernel_filenames": kernels[:30],
        "kernel_root_subvolume_override": override,
        "kernel_rootflags_checked": cmdline is not None,
        "boot_config_root_subvolume_overrides": configured,
        "boot_config_sources_checked": checked,
        "fstab_root_subvolume_override": fstab_override,
        "boot_subvolume_override_detected": any_override,
        "default_subvolume_change_sufficient_for_boot": (
            False if any_override else None
        ),
        "boot_subvolume_note": (
            "An explicit Btrfs subvolume was found in the active kernel "
            "arguments, a detected boot entry, or the root fstab entry. "
            "Switching the default subvolume alone does not guarantee "
            "reboot into the restored system."
            if any_override else
            "No explicit Btrfs subvolume was detected in the checked files. "
            "This is NOT evidence that switching the default root is safe; "
            "other boot entries, initramfs and recovery paths remain untested."
        ),
        "bootloader_config_present": config_files,
        "rollback_verified": False,
        "note": ("No rollback or boot entries were changed. File presence "
                 "alone never proves the system will recover after failure."),
    }


def main(argv=None):
    argparse.ArgumentParser(description=__doc__).parse_args(argv)
    print(json.dumps(status(), indent=2))


if __name__ == "__main__":
    main()
