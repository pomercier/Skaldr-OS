function qt_wait_else() {
    local test_name="$1"
    local fallback="$2"
    local text="$3"
    local retries=$4
    local interval=$5

    for c in $( seq 1 $retries ); do
        qt_echo "🔁 $c / $retries «$text» "
        qt_screenshot_ppm "$test_name"
        # We only ever OCR the most recent image, so we just send the text name and the screenshot count
        if qt_search_screenshot "$test_name" "$text"; then
            return 0
        fi
        qt_wait_for_seconds "$interval"
    done

    "$fallback" "$test_name"

    qt_test_fail "Coulnd't find text «$text» in screenshot «$QT_SCREENSHOT_COUNT» after $retries retries"
}

function test_post_boot_grub() {
    qt_wait_for_seconds 5
    qt_wait_for_text "$FUNCNAME" "GNU GRUB" 3 5
    qt_screenshot_ppm "$FUNCNAME"
    qt_send_key "return"
}

function test_launch_calamares() {
    # Proven failure: KRunner does not open in this Quickemu live session.
    # Use the visible "Launch installer" button in CachyOS Hello instead.
    # QEMU HMP supports mouse_move and mouse_button, even though Quicktest
    # has not implemented its own mouse-click helper yet.
    qt_wait_for_seconds 90
    qt_wait_for_text "$FUNCNAME" "Launch installer" 8 5
    qt_screenshot_ppm "$FUNCNAME"

    # Quickemu's automated display is 1408x792 on the current CI runner.
    # The real button is centered at roughly (width/2, height*0.76).
    # Scale for other resolutions so the test does not depend on one size.
    local snapshot width height target_x target_y
    snapshot="$(find "$QT_RESULTS" -type f -name "screenshot_*.ppm" | sort | tail -n 1)"
    [[ -f "$snapshot" ]] || qt_test_fail "Could not inspect live desktop screenshot"
    width="$(identify -format "%w" "$snapshot")"
    height="$(identify -format "%h" "$snapshot")"
    [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || qt_test_fail "Invalid screenshot dimensions"
    # Screenshots show the installer button at about 45% of width and
    # 74% of height, rather than centered on the physical display.
    target_x=$((width * 45 / 100))
    target_y=$((height * 74 / 100))
    qt_echo "Clicking the real installer button at $target_x,$target_y on $width x $height"
    # Quickemu's USB tablet ignores HMP relative mouse events. The VM config
    # uses a relative USB mouse, and movements are small enough for HID.
    local i dx dy prev_x=0 prev_y=0
    for ((i=0; i<20; i++)); do
        qt_send_command "mouse_move -80 -80"
    done
    for ((i=1; i<=20; i++)); do
        dx=$((target_x * i / 20 - prev_x))
        dy=$((target_y * i / 20 - prev_y))
        qt_send_command "mouse_move $dx $dy"
        prev_x=$((target_x * i / 20))
        prev_y=$((target_y * i / 20))
    done
    qt_wait_for_seconds 1
    qt_screenshot_ppm "$FUNCNAME"
    qt_send_command "mouse_button 1"
    qt_wait_for_seconds 1
    qt_send_command "mouse_button 0"
    qt_screenshot_ppm "$FUNCNAME"
    # Preserve a strict assertion that the actual installer opens.
    qt_wait_for_seconds 12
}

