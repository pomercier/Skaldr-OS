function qt_wait_else() {
    local test_name="$1"
    local fallback="$2"
    local text="$3"
    local retries=$4
    local interval=$5

    for c in $( seq 1 $retries ); do
        qt_echo "🔁 $c / $retries «$text» "
        qt_screenshot_ppm "$test_name"
        # We only ever OCR the most recent image, so we just send the text name and the screenshot count
        if qt_search_screenshot "$test_name" "$text"; then
            return 0
        fi
        # Stop promptly on a genuine installer error; never report success.
        if [[ "$test_name" == "test_calamares_finished" ]] && qt_search_screenshot "$test_name" "Installation Failed"; then
            qt_test_fail "Calamares reported Installation Failed; inspect the installer serial artifact"
        fi
        qt_wait_for_seconds "$interval"
    done

    "$fallback" "$test_name"

    qt_test_fail "Coulnd't find text «$text» in screenshot «$QT_SCREENSHOT_COUNT» after $retries retries"
}

function test_ci_cpu_model() {
    # Quickemu 4.9.9 prints a host CPU label even when extra_args
    # overrides its default. Verify the last effective QEMU -cpu option.
    local pid_file="${QUICKEMU_VM_DIR}/cachyos-dailylive/cachyos-dailylive.pid"
    [[ -s "$pid_file" ]] || qt_test_fail "CPU validation: no QEMU process"
    local pid model
    pid="$(cat "$pid_file")"
    [[ -r "/proc/$pid/cmdline" ]] || qt_test_fail "CPU validation: missing process arguments"
    model="$(tr '\0' '\n' < "/proc/$pid/cmdline" | awk '$0 == "-cpu" { getline; cpu = $0 } END { print cpu }')"
    qt_echo "Effective QEMU CPU model: $model"
    [[ "$model" == "x86-64-v3" ]] || qt_test_fail "CPU validation: expected x86-64-v3, received $model"
}

function test_post_boot_grub() {
