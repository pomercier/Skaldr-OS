    qt_echo "Launch installed Skaldr Control Center in KDE Plasma"
    qt_send_key_combo "alt-f4"
    qt_wait_for_seconds 2
    qt_send_key_combo "alt-f2"
    qt_wait_for_seconds 2
    qt_send_string_return "skaldr-center"
    # Real QEMU captures from both UEFI installs (run 43648608032) show a
    # fully loaded native Control Center and live kernel data. Tesseract
    # consistently reads "Live system heaith", causing a false failure.
    # The next two independent cues were legible in 9/10 archived OCR frames
    # for EACH VM. Require the UI header, refresh control AND populated data.
    qt_wait_for_text "$FUNCNAME" "System overview" 18 6
    qt_wait_for_text "$FUNCNAME" "Refresh information" 8 5
    qt_wait_for_text "$FUNCNAME" "Kernel:" 8 5
    qt_screenshot_ppm "$FUNCNAME"
    # No privileged operation is selected or executed by this smoke test.
}


function test_installed_artcraft_launcher() {
    # Pilot the real installed GUI in the GRUB/ext4 path first. The Limine
    # matrix must continue testing rollback independently of this new app.
    if [[ "${TEST_BOOTLOADER:-}" != "grub" ||
          "${TEST_FILESYSTEM:-}" != "ext4" ]]; then
        return 0
    fi
    qt_echo "Verify installed official ArtCraft AppImage checksum in the real guest"
    qt_send_key_combo "alt-f4"
    qt_wait_for_seconds 2
    qt_send_key_combo "alt-f2"
    qt_wait_for_seconds 2
    # --diagnose computes the official SHA-256 against /opt/skaldr/artcraft,
    # rather than treating a .desktop file or an AppImage icon as success.
    qt_send_string_return "konsole --hold -e /usr/local/bin/skaldr-artcraft --diagnose"
    # Actual GitHub Actions screenshots in runs 44777785711 (attempts 1
    # and 2) show the SHA-256 verified terminal, but OCR misreads the very
    # small "Bundled AppImage" label as "Bundled AppInag". Both phrases
    # below are consistently legible in 15 consecutive archived frames and
    # are emitted only AFTER the app's full SHA-256 digest matches.
    # Preserve this installed-guest integrity check and the native GUI test.
    qt_wait_for_text "$FUNCNAME" "executable verified" 15 5
    qt_wait_for_text "$FUNCNAME" "GUI startup not tested" 8 4
    qt_screenshot_ppm "$FUNCNAME"

    qt_echo "Open ArtCraft's actual native graphical launcher inside installed KDE"
    qt_send_key_combo "alt-f4"
    qt_wait_for_seconds 2
    qt_send_key_combo "alt-f2"
    qt_wait_for_seconds 2
    qt_send_string_return "skaldr-artcraft"
    # Real QEMU screenshots (run 44132973459) prove the checksum-verified
    # native ArtCraft launcher is running and its catalog is populated.
    # PhotoCraft is below the first alphabetical grid, so that old assertion
    # generated a false failure despite a working graphical interface.
    # Assert three independent native-GUI cues present in actual screenshots
    # 0060 and 0074 that the checksum diagnostic alone cannot produce.
    qt_wait_for_text "$FUNCNAME" "ARTCRAFT" 12 5
    qt_wait_for_text "$FUNCNAME" "AniCraft" 10 5
    qt_wait_for_text "$FUNCNAME" "AVAILABLE TO INSTALL" 10 5
    qt_screenshot_ppm "$FUNCNAME"
    qt_echo "PASS: installed ArtCraft AppImage SHA-256 and native catalog GUI"
}

function test_installed_btrfs_snapshot_rollback() {
    # This is a REAL Calamares-installed VM rollback, not the smaller
    # independent BusyBox Btrfs test. Keep the other matrix jobs unchanged.
    if [[ "${TEST_BOOTLOADER:-}" != "limine" ||
          "${TEST_FILESYSTEM:-}" != "btrfs" ]]; then
        return 0
    fi
    qt_echo "Power down the installed Limine/Btrfs VM for offline rollback"
    qt_poweroff_vm
    qt_wait_for_seconds 5

    local qcow2="${QUICKEMU_VM_DIR}/cachyos-dailylive/disk.qcow2"
    [[ -s "$qcow2" ]] || qt_test_fail "Calamares-installed Btrfs disk missing"
    local absolute_qcow2
    absolute_qcow2="$(realpath -e "$qcow2")" ||
        qt_test_fail "Could not resolve disposable VM disk"
    # The helper accepts only the absolute CI Quickemu disk path and modifies
    # ONLY a QCOW2 copy; no real drives or host bootloaders are touched.
    SKALDR_CI_INSTALLED_ROLLBACK=disposable-calamares-qcow2 \
        bash scripts/skaldr-ci-installed-rollback.sh "$absolute_qcow2" ||
        qt_test_fail "Offline Btrfs recovery of installed VM failed"
    qt_echo "Reboot restored Calamares installation without the installer ISO"
    qt_launch_quickemu || qt_test_fail "Could not boot restored installed disk"
    qt_wait_for_seconds 8
    qt_get_qemu_socket || qt_test_fail "Restored VM QEMU monitor missing"
    test_ci_cpu_model

    local pid_file="${QUICKEMU_VM_DIR}/cachyos-dailylive/cachyos-dailylive.pid"
    [[ -s "$pid_file" ]] || qt_test_fail "Restored VM QEMU PID missing"
    local qemu_pid
    qemu_pid="$(cat "$pid_file")"
    [[ -r "/proc/$qemu_pid/cmdline" ]] ||
        qt_test_fail "Restored VM process absent"
    if grep -aFq '.iso' "/proc/$qemu_pid/cmdline"; then
        qt_test_fail "Restored VM still depends on installer ISO"
    fi

    qt_wait_for_text "$FUNCNAME" "Show On-Screen Keyboard" 30 10
    # The installed greeter must display Skaldr's own branding, not KDE's
    # generic login background. Actual QEMU frames (run 43902261411) show
    # the full SKALDR OS logo, but Tesseract truncates its stylized letters
    # to "KALDR O"; the independent wallpaper motto is read verbatim in
    # seven successive captures. Require that stable, branded visual cue.
    qt_wait_for_text "$FUNCNAME" "PERFORMANCE BY INTENTION" 8 3
    qt_screenshot_ppm "$FUNCNAME"
    local snapshot width height
    snapshot="$(find "$QT_RESULTS" -type f -name 'screenshot_*.ppm' | sort | tail -n 1)"
    [[ -f "$snapshot" ]] || qt_test_fail "Restored KDE greeter screenshot missing"
    width="$(identify -format '%w' "$snapshot")"
    height="$(identify -format '%h' "$snapshot")"
    python3 scripts/skaldr-qmp-click.py \
        --x "$((width / 2))" --y "$((height * 60 / 100))" \
        --width "$width" --height "$height" ||
        qt_test_fail "Could not focus restored KDE login"
    qt_wait_for_seconds 1
    qt_send_string_return "$test_password"
    qt_wait_for_seconds 12

    # Actual guest filesystem evidence: the output comes from a command run
    # AFTER Plasma login, not from the host's Btrfs snapshot directory.
    qt_echo "Prove the logged-in restored guest has the original root marker"
    qt_send_key_combo "alt-f2"
    qt_wait_for_seconds 2
    qt_send_string_return "konsole --hold -e cat /etc/skaldr-ci-rollback-state"
    qt_wait_for_text "$FUNCNAME" "original-before-rollback" 20 5
    qt_screenshot_ppm "$FUNCNAME"

    qt_echo "Validate the native Skaldr dashboard after Btrfs restoration"
    qt_send_key_combo "alt-f4"
    qt_wait_for_seconds 2
    qt_send_key_combo "alt-f2"
    qt_wait_for_seconds 2
    qt_send_string_return "skaldr-center"
    qt_wait_for_text "$FUNCNAME" "System overview" 18 6
    qt_wait_for_text "$FUNCNAME" "Kernel:" 8 5
    qt_screenshot_ppm "$FUNCNAME"
    qt_echo "PASS: real Calamares-installed Limine/Btrfs rollback, cold boot and KDE"
}

