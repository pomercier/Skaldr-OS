function test_installed_system_cold_boot() {
    # A successful Calamares dialog is not proof the installed OS boots.
    # Power down and restart Quickemu. It automatically detaches the ISO
    # when the installed qcow2 disk contains data; assert this explicitly.
    qt_echo "Cold boot the newly installed system, without the live ISO"
    qt_poweroff_vm
    qt_wait_for_seconds 5
    local disk_file="${QUICKEMU_VM_DIR}/cachyos-dailylive/disk.qcow2"
    [[ -s "$disk_file" ]] || qt_test_fail "Installed virtual disk missing"
    qt_launch_quickemu || qt_test_fail "Could not relaunch the installed disk"
    qt_wait_for_seconds 8
    qt_get_qemu_socket || qt_test_fail "QEMU monitor missing after cold boot"
    test_ci_cpu_model

    # The second boot must be sourced from the installed disk, not the ISO.
    local pid_file="${QUICKEMU_VM_DIR}/cachyos-dailylive/cachyos-dailylive.pid"
    [[ -s "$pid_file" ]] || qt_test_fail "Second-boot QEMU PID missing"
    local qemu_pid
    qemu_pid="$(cat "$pid_file")"
    [[ -r "/proc/$qemu_pid/cmdline" ]] || qt_test_fail "Second-boot QEMU process missing"
    if grep -aFq '.iso' "/proc/$qemu_pid/cmdline"; then
        qt_test_fail "Second boot still has live installer ISO attached"
    fi

    # The installed greeter is visible, but OCR can miss its low-contrast
    # user label. The on-screen keyboard control is reliably readable in
    # the actual CI screenshots, even after the central widgets fade.
    qt_wait_for_text "$FUNCNAME" "Show On-Screen Keyboard" 30 10
    qt_screenshot_ppm "$FUNCNAME"

    # Wake the idle greeter and focus its central password field. The
    # following test still requires a real password-protected KDE login
    # and the first-run Skaldr welcome, not just this screen marker.
    local snapshot width height
    snapshot="$(find "$QT_RESULTS" -type f -name "screenshot_*.ppm" | sort | tail -n 1)"
    [[ -f "$snapshot" ]] || qt_test_fail "Installed greeter screenshot missing"
    width="$(identify -format "%w" "$snapshot")"
    height="$(identify -format "%h" "$snapshot")"
    qt_echo "Focus installed login with QMP at $((width / 2)),$((height * 60 / 100))"
    python3 scripts/skaldr-qmp-click.py --x "$((width / 2))" --y "$((height * 60 / 100))" --width "$width" --height "$height" || qt_test_fail "QMP login focus failed"
    qt_wait_for_seconds 1
    qt_screenshot_ppm "$FUNCNAME"
}

function test_installed_plasma_first_login() {
    # The login greeter alone is not proof that Plasma starts successfully.
    # The installed account must accept the password and display Skaldr's
    # release-provenance dialog during its first KDE session.
    qt_echo "Log into the installed Plasma session with the test account"
    qt_send_string_return "$test_password"
    qt_wait_for_text "$FUNCNAME" "Welcome to Skaldr OS" 30 10
    qt_screenshot_ppm "$FUNCNAME"
}

function test_power_off_vm() {
    qt_poweroff_vm
}

function test_input_validation() {
    local -Ar bootloaders=(
        ["grub"]="0"
        ["refind"]="1"
        ["refind-ai"]="2"
        ["systemd-boot"]="3"
        ["limine"]="4"
    )

    local -Ar filesystems=(
        ["btrfs"]="0"
        ["xfs"]="1"
        ["ext4"]="2"
        ["f2fs"]="3"
        ["zfs"]="4"
    )

    local bootloader="${TEST_BOOTLOADER:-Limine}"
    local -g bootloader_index="${bootloaders[$bootloader]}"

    if [ -z "$bootloader_index" ]; then
        qt_echo "🚨 Unknown bootloader passed: $bootloader"
        exit 1
    else
        qt_echo "✅ Selected bootloader is $bootloader ($bootloader_index)"
    fi

    local filesystem="${TEST_FILESYSTEM:-btrfs}"
    local -g filesystem_index="${filesystems[$filesystem]}"

    if [ -z "$filesystem_index" ]; then
        qt_echo "🚨 Unknown filesystem passed: $filesystem"
        exit 1
    else
        qt_echo "✅ Selected filesystem is $filesystem ($filesystem_index)"
    fi

    qt_echo "✅ Validation passed"
}

