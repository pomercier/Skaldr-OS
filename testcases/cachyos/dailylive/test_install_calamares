function test_launch_calamares() {
    # Regression evidence: the real 1408x792 screenshot has a working
    # "Launch installer" button, but Tesseract recognizes it as
    # "Launchinstaler". Detect the stable dialog heading instead, then
    # click the button with tablet QMP coordinates.
    qt_wait_for_seconds 90
    qt_wait_for_text "$FUNCNAME" "Welcome to Skaldr OS" 8 5
    qt_screenshot_ppm "$FUNCNAME"

    local snapshot width height target_x target_y
    snapshot="$(find "$QT_RESULTS" -type f -name "screenshot_*.ppm" | sort | tail -n 1)"
    [[ -f "$snapshot" ]] || qt_test_fail "No live welcome screenshot"
    width="$(identify -format "%w" "$snapshot")"
    height="$(identify -format "%h" "$snapshot")"
    target_x=$((width * 53 / 100))
    target_y=$((height * 59 / 100))
    qt_echo "Click visible Skaldr installer button at $target_x,$target_y"
    python3 scripts/skaldr-qmp-click.py --x "$target_x" --y "$target_y" --width "$width" --height "$height" || qt_test_fail "Skaldr installer QMP click failed"
    qt_wait_for_seconds 15
    qt_screenshot_ppm "$FUNCNAME"
}

function test_calamares_welcome() {
    # The real installer can refresh its keyring and install packages first.
    # This remains an actual Calamares window assertion, not an unconditional
    # pass or a search for the unrelated CachyOS Hello desktop.
    qt_wait_for_text "$FUNCNAME" "$text_calamares_welcome" 12 15
    qt_screenshot_ppm "$FUNCNAME"

    # The separate "Skaldr Support" and "Known issues" links changed the
    # welcome page tab order. Two tabs + Space now selects Known issues,
    # rather than Next. Click the visibly enabled Next button instead.
    # Verified against 1408x792 CI screenshots: x=1103, y=711.
    local snapshot width height
    snapshot="$(find "$QT_RESULTS" -type f -name "screenshot_*.ppm" | sort | tail -n 1)"
    [[ -f "$snapshot" ]] || qt_test_fail "Calamares welcome screenshot missing"
    width="$(identify -format "%w" "$snapshot")"
    height="$(identify -format "%h" "$snapshot")"
    qt_echo "Advance branded Calamares welcome with QMP at $((width * 78 / 100)),$((height * 90 / 100))"
    python3 scripts/skaldr-qmp-click.py \
        --x "$((width * 78 / 100))" --y "$((height * 90 / 100))" \
        --width "$width" --height "$height" || qt_test_fail "Calamares Next QMP click failed"
    qt_wait_for_text "$FUNCNAME" "$text_calamares_language" 10 5
}

